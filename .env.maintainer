# This file is updated by the maintaining team as keys or details change. You
# should not need to manually adjust it. If you wish to override it, there are
# instructions in the README file.

# The name of this image.
IMAGE_NAME=petros

# The URL where the attic server can be reached.
ATTIC_SERVER_URL=http://167.71.179.207:8080

# The name of the attic cache to draw Nix binaries from.
ATTIC_CACHE=sigil

# The public key of the attic cache.
ATTIC_PUBLIC_KEY=FOTZlbn++lfKxP6la9AqP8lg84g9pCLbJkJInMWlUiM=

# The URL where large, specifically-vendored binaries are downloaded from.
VENDOR_BASE_URL=https://sigil-attic.nyc3.digitaloceanspaces.com/sigil-tarballs

# The SP1 release that drives the path for both the cargo-prove CLI and the
# Succinct rust toolchain. Pins every vendored SP1 asset back to a specific
# upstream release. Bump this in lockstep with sp1-sdk dependency upgrades
# downstream; re-extract and re-upload to
# ${VENDOR_BASE_URL}/sp1/<new-version>/{cargo_prove_<new-version>_linux_amd64,rust-toolchain-x86_64-unknown-linux-gnu}.tar.gz
SP1_VERSION=v6.2.2

# The RISC Zero rust toolchain version (rustc self-reports this — e.g. rzup
# installs it to ~/.risc0/toolchains/v<RISC0_TOOLCHAIN_VERSION>-rust-<target>/).
# Pins the risc0-build-compatible rust toolchain byte-for-byte. Bump in
# lockstep with risc0-zkvm upgrades downstream.
RISC0_TOOLCHAIN_VERSION=1.94.1

# The attic-client/server build snapshot used when `bootstrap-attic.sh` was
# last run. Derived from the attic-*.outpath nix store path suffix (e.g.
# `attic-0-unstable-2025-09-24` → `unstable-2025-09-24`). Bump when the
# bootstrap is re-run and the store paths change; the sha256 + both .outpath
# files get committed under src/attic/<new-version>/ and uploaded to
# ${VENDOR_BASE_URL}/attic/<new-version>/attic-store.tar.gz.
ATTIC_VERSION=unstable-2025-09-24

# The upstream nix release whose statically-linked binary is vendored.
# Mirrors the `nix --version` output of the binary at src/nix/<NIX_VERSION>/nix.
# Bump when the static nix binary is refreshed.
NIX_VERSION=2.24.10
