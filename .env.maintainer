# This file is updated by the maintaining team as keys or details change. You
# should not need to manually adjust it. If you wish to override it, there are
# instructions in the README file.

# The name of this image.
IMAGE_NAME=petros

# The URL where the attic server can be reached.
ATTIC_SERVER_URL=http://167.71.179.207:8080

# The name of the attic cache to draw Nix binaries from.
ATTIC_CACHE=sigil

# The public key of the attic cache.
ATTIC_PUBLIC_KEY=FOTZlbn++lfKxP6la9AqP8lg84g9pCLbJkJInMWlUiM=

# The URL where large, specifically-vendored binaries are downloaded from.
VENDOR_BASE_URL=https://sigil-attic.nyc3.digitaloceanspaces.com/sigil-tarballs

# The SP1 release that drives the path for both the cargo-prove CLI and the
# Succinct rust toolchain. Pins every vendored SP1 asset back to a specific
# upstream release. Bump this in lockstep with sp1-sdk dependency upgrades
# downstream; re-extract and re-upload to
# ${VENDOR_BASE_URL}/sp1/<new-version>/{cargo_prove_<new-version>_linux_amd64,rust-toolchain-x86_64-unknown-linux-gnu}.tar.gz
SP1_VERSION=v6.2.2

# The RISC Zero rust toolchain version (rustc self-reports this; e.g. rzup
# installs it to ~/.risc0/toolchains/v<RISC0_TOOLCHAIN_VERSION>-rust-<target>/).
# Pins the risc0-build-compatible rust toolchain byte-for-byte. Bump in
# lockstep with risc0-zkvm upgrades downstream.
RISC0_TOOLCHAIN_VERSION=1.94.1

# The RISC Zero CPP toolchain version (tagged as YYYY.MM.DD by upstream
# `risc0/toolchain` releases). Provides the riscv32im-unknown-elf GCC/G++
# cross-toolchain that the risc0-zkvm guest crate's build.rs cross-compiles
# its C/C++ syscall-stub layer with. rzup installs to
# ~/.risc0/toolchains/v<RISC0_CPP_TOOLCHAIN_VERSION>-cpp-<target>/. Bump
# alongside RISC0_TOOLCHAIN_VERSION when risc0-zkvm needs a newer cpp; re-
# extract + re-upload to
# ${VENDOR_BASE_URL}/risc0/cpp/<new-version>/riscv32im-linux-x86_64.tar.xz.
RISC0_CPP_TOOLCHAIN_VERSION=2024.01.05

# The OpenVM release that drives the path for both the vendored OpenVM guest
# rust toolchain and the cargo-openvm CLI. Pins every vendored OpenVM asset
# back to a specific upstream tag. Bump this in lockstep with openvm-sdk
# dependency upgrades downstream; re-produce and re-upload to
# ${VENDOR_BASE_URL}/openvm/<new-version>/{rust-toolchain-x86_64-unknown-linux-gnu,cargo-openvm_<new-version>_linux_amd64}.tar.gz
OPENVM_VERSION=v2.0.1

# The stock upstream nightly channel that openvm-build pins for guest builds
# (its DEFAULT_RUSTUP_TOOLCHAIN_NAME). The vendored toolchain tarball is a
# rustup install of exactly this channel plus the rust-src component; the
# Dockerfile materializes it under $RUSTUP_HOME with this name. Bump in
# lockstep with OPENVM_VERSION when upstream re-pins its nightly.
OPENVM_RUST_TOOLCHAIN=nightly-2026-01-18

# The Perpetual Powers of Tau contribution the vendored OpenVM KZG params
# (kzg_bn254_{10..24}.srs) were converted from, naming the artifact set at
# ${VENDOR_BASE_URL}/openvm/kzg/<OPENVM_KZG_VERSION>/. Matches the
# `challenge_0085` object prefix in openvm's upstream axiom-crypto S3 source.
OPENVM_KZG_VERSION=challenge_0085

# solc static-binary release vendored for openvm-sdk's EVM verifier
# bytecode emission (the generated contracts pin this exact version).
# Assets at ${VENDOR_BASE_URL}/solidity/<SOLC_VERSION>/; hash pins at
# src/solidity/<SOLC_VERSION>/.
SOLC_VERSION=v0.8.19

# OPTIONAL: Toggle warm build caches (default: 1). With 1, the docker
# layer cache applies and BuildKit cache mounts persist vendor downloads
# and the local nix NAR mirror across builds: bumping or adding one
# asset re-fetches only that asset, and a flake change refills the
# fresh nix store from local disk instead of re-downloading the whole
# closure from attic. Every vendor cache hit is still verified against
# the committed sha256 pins, and mirror substitution stays fully
# signature checked (attic's key for attic-sourced paths, the mirror's
# own key for locally built ones). Set 0 for the pristine release/CI
# flow: layer cache bypassed, download caches and mirror start empty,
# every byte fetched fresh from the CDN and attic.
DOCKER_BUILD_CACHE=1

# The attic-client/server build snapshot used when `bootstrap-attic.sh` was
# last run. Derived from the attic-*.outpath nix store path suffix (e.g.
# `attic-0-unstable-2025-09-24` → `unstable-2025-09-24`). Bump when the
# bootstrap is re-run and the store paths change; the sha256 + both .outpath
# files get committed under src/attic/<new-version>/ and uploaded to
# ${VENDOR_BASE_URL}/attic/<new-version>/attic-store.tar.gz.
ATTIC_VERSION=unstable-2025-09-24

# The upstream nix release whose statically-linked binary is vendored.
# Mirrors the `nix --version` output of the binary at src/nix/<NIX_VERSION>/nix.
# Bump when the static nix binary is refreshed.
NIX_VERSION=2.24.10

# circom release whose linux-amd64 binary is vendored at
# ${VENDOR_BASE_URL}/circom/<CIRCOM_VERSION>/circom. Pinned exactly: the RISC
# Zero Groth16 verification reproduces an r1cs whose hash is circom-sensitive.
CIRCOM_VERSION=2.2.2

# snarkjs release whose node_modules closure is vendored at
# ${VENDOR_BASE_URL}/snarkjs/<SNARKJS_VERSION>/snarkjs-node-modules.tar.gz.
SNARKJS_VERSION=0.7.6

# RISC Zero Groth16 trusted-setup ceremony date, naming the artifact set at
# ${VENDOR_BASE_URL}/risc0/groth16/<R0_GROTH16_VERSION>/ (ptau, zkey, circom
# sources, control_id.rs, attestation-gist archive, upstream verification
# doc snapshot). Matches RISC Zero's tsc/2024-04-04 publication.
R0_GROTH16_VERSION=2024-04-04

# Perpetual Powers of Tau chain-evidence set at
# ${VENDOR_BASE_URL}/ppot/<PPOT_VERSION>/ (contribution-record chain,
# independent record extraction, raw-mirror cross-bind slices, ceremony
# repo bundle, archival metadata). Named by the latest ceremony
# contribution the record chain covers; bump only if we refresh the
# evidence set after future contributions (Sigil's anchors at 54 and 84
# never move).
PPOT_VERSION=0086

# Ethereum KZG Summoning Ceremony artifact set at
# ${VENDOR_BASE_URL}/ethereum-kzg/<ETH_KZG_VERSION>/ (full sequencer
# transcript + trusted_setup_4096.json). Named by the ceremony's end
# date; the ceremony is closed, so this never bumps.
ETH_KZG_VERSION=2023-08-08
